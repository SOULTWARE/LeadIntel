generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OutreachStage {
  NOT_CONTACTED
  FIRST_EMAIL_SENT
  FOLLOW_UP_1_SENT
  FOLLOW_UP_2_SENT
  HOT_LEAD
  NO_RESPONSE
}

enum CandidateStatus {
  DISCOVERED
  VERIFYING
  VERIFIED
  FAILED
  CONVERTED
}

model Candidate {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyName         String
  domainCandidates    Json     @default("[]")
  profileUrls         Json     @default("[]")
  discoveryProvenance Json     @default("[]")
  discoveryConfidence Int?

  discoveredAt DateTime @default(now())
  status       CandidateStatus @default(DISCOVERED)

  leads     Lead[]
  snapshots Snapshot[]

  @@index([companyName])
  @@index([status])
  @@map("candidates")
}

model Lead {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyName   String
  website       String?
  industry      String?
  employeeCount Int?
  location      String?
  description   String?

  leadScore       Float?
  confidenceScore Float?

  outreachStage  OutreachStage @default(NOT_CONTACTED)
  requiresReview Boolean       @default(false)
  domain         String?       @unique
  leadPurpose    String?

  // Actionability fields for quick UX decisions
  actionable         Boolean @default(false)
  actionabilityScore Int?    // 0-100
  primaryOpportunity String? // short human one-liner

  aiRawOutput Json?

  candidateId String?    @db.Uuid
  candidate   Candidate? @relation(fields: [candidateId], references: [id])

  decisionMakers DecisionMaker[]
  issues         Issue[]
  emailDrafts    EmailDraft[]

  @@index([candidateId])
  @@map("leads")
}

model DecisionMaker {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstName String
  lastName  String
  title     String?
  role      String?

  aiRawOutput Json?

  leadId String @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  contacts Contact[]

  @@map("decision_makers")
}

model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type  String
  value String

  isPrimary  Boolean @default(false)
  isVerified Boolean @default(false)

  decisionMakerId String        @db.Uuid
  decisionMaker   DecisionMaker @relation(fields: [decisionMakerId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

model Issue {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?
  category    String?
  severity    String?

  confidenceScore Float?

  aiRawOutput Json?

  leadId String @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  sourceEvidenceId String?         @db.Uuid
  sourceEvidence   SourceEvidence? @relation(fields: [sourceEvidenceId], references: [id])

  snapshotId String?   @db.Uuid
  snapshot   Snapshot? @relation(fields: [snapshotId], references: [id])

  @@index([snapshotId])
  @@map("issues")
}

model SourceEvidence {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceType String
  sourceUrl  String?
  rawContent String?
  snippet    String?

  retrievedAt DateTime @default(now())

  aiRawOutput Json?

  issues Issue[]

  @@map("source_evidences")
}

model EmailDraft {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject String
  body    String
  version Int    @default(1)
  status  String @default("draft")
  sentAt  DateTime?

  aiRawOutput Json?

  leadId String @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("email_drafts")
}

model Snapshot {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  url           String
  httpStatus    Int
  contentType   String?
  html          String
  textExtract   String?
  sourceType    String?
  headers       Json?

  candidateId   String?    @db.Uuid
  candidate     Candidate? @relation(fields: [candidateId], references: [id])
  candidateName String?

  fetchedAt DateTime @default(now())

  verifiedResources VerifiedResource[]
  issues            Issue[]

  @@index([candidateId])
  @@index([url])
  @@index([sourceType])
  @@map("snapshots")
}

model VerifiedResource {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  candidateRef String
  sourceUrl    String
  sourceType   String
  httpStatus   Int
  contentType  String?
  bodyText     String?

  rawHtmlSnapshotPath String?

  fetchedAt DateTime @default(now())
  headers   Json?

  snapshotId String?   @db.Uuid
  snapshot   Snapshot? @relation(fields: [snapshotId], references: [id])

  skipReason String?

  @@index([candidateRef])
  @@map("verified_resources")
}

model RawAiResponse {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  candidateId  String?  @db.Uuid
  leadId       String?  @db.Uuid
  responseType String
  prompt       String?
  response     Json
  modelUsed    String?
  tokensUsed   Int?

  @@index([candidateId])
  @@index([leadId])
  @@index([responseType])
  @@map("raw_ai_responses")
}

model EvidenceVerification {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  snapshotId      String  @db.Uuid
  issueId         String? @db.Uuid
  originalExcerpt String?
  newExcerpt      String
  isValid         Boolean
  notes           String?
  verifierId      String?
  verifiedAt      DateTime @default(now())

  @@index([snapshotId])
  @@index([issueId])
  @@map("evidence_verifications")
}
