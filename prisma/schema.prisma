generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Scraped Data
  name      String
  address   String?
  phone     String?
  website   String?
  rating    Float?
  reviews   Int?
  type      String?
  placeId   String?  @unique

  // Search Context
  searchQuery String?
  location    String?

  // AI Analysis Data
  compatibilityScore Int?
  recommendation     String?
  reasoning          String?
  identifiedProblems Json?   @default("[]")
  compatibilityHooks Json?   @default("[]")

  // Status
  isEnhanced Boolean @default(false)

  @@index([placeId])
  @@index([compatibilityScore])
  @@map("leads")
}
