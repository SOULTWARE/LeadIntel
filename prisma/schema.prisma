generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Scraped Data
  name      String
  address   String?
  phone     String?
  email     String?
  website   String?
  rating    Float?
  reviews   Int?
  type      String?
  placeId   String?  @unique

  // Search Context
  searchQuery String?
  location    String?

  // AI Analysis Data
  compatibilityScore Int?
  qualityScore       Int?
  recommendation     String?
  reasoning          String?
  identifiedProblems Json?   @default("[]")
  compatibilityHooks Json?   @default("[]")
  decisionMakerRoles Json?   @default("[]")
  primaryDecisionMakerRole String?
  warmupSignals      Json?   @default("{}")
  warmupScore        Int     @default(0)
  linkedinTouchedAt  DateTime?
  contentEngagedAt   DateTime?
  warmIntroRequestedAt DateTime?

  // AI Outreach Draft
  emailDraftSubject     String?
  emailDraftBody        String?
  emailDraftGeneratedAt DateTime?

  // Status
  isEnhanced Boolean @default(false)

  processingState        LeadProcessingState   @default(NEW)
  emailVerificationStatus EmailVerificationStatus @default(UNVERIFIED)
  emailVerifiedAt        DateTime?
  emailVerificationProvider String?
  sentCount              Int @default(0)
  bounceCount            Int @default(0)
  responseCount          Int @default(0)
  openCount              Int @default(0)
  clickCount             Int @default(0)

  companyId String? @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id])

  searchId String? @db.Uuid
  search   Search? @relation(fields: [searchId], references: [id])

  campaignId String? @db.Uuid
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  batchId String? @db.Uuid
  batch   LeadBatch? @relation(fields: [batchId], references: [id])

  primaryContactId String? @db.Uuid
  primaryContact   Contact? @relation("LeadPrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)

  segmentName String?

  // Ownership
  userId    String

  // Relations
  sessionId String?  @db.Uuid
  session   Session? @relation(fields: [sessionId], references: [id])
  contacts  Contact[] @relation("LeadContacts")
  events    OutreachEvent[]

  @@index([placeId])
  @@index([searchId])
  @@index([compatibilityScore])
  @@index([qualityScore])
  @@index([campaignId])
  @@index([batchId])
  @@index([primaryContactId])
  @@map("leads")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  name      String
  target    String?
  location  String?
  userId    String
  leads     Lead[]

  @@map("sessions")
}

enum LeadProcessingState {
  NEW
  ENRICHING
  ENRICHED
  EMAIL_DISCOVERING
  EMAIL_DISCOVERED
  EMAIL_NOT_FOUND
  VERIFYING
  VERIFIED
  AI_SCORING
  COMPLETE
  FAILED
}

enum EmailVerificationStatus {
  UNVERIFIED
  VALID
  INVALID
  RISKY
  UNKNOWN
}

enum SearchStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
  CANCELED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
}

enum JobType {
  SEARCH_FETCH_CANDIDATES
  LEAD_ENRICH
  EMAIL_DISCOVER
  EMAIL_VERIFY
  AI_ANALYZE
}

enum PlanType {
  STARTER
  PRO
}

enum BatchStatus {
  DRAFT
  READY
  EXPORTED
  ACTIVE
  COMPLETE
}

enum OutreachEventType {
  SENT
  DELIVERED
  OPEN
  CLICK
  REPLY
  BOUNCE
}

model Search {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  status SearchStatus @default(PENDING)

  industry String
  location String
  employeeRangeMin Int?
  employeeRangeMax Int?
  revenueRange String?
  targetRoles Json? @default("[]")
  qualityStrictness Int @default(50)
  segmentName String?
  keywords Json? @default("[]")

  rawInput Json?

  campaignId String? @db.Uuid
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  leads Lead[]

  @@index([userId, createdAt])
  @@map("searches")
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name           String
  normalizedName String
  domain         String? @unique
  websiteUrl     String?

  hqLocation String?
  employeeCountEstimate Int?
  companySize String?
  revenueRange String?
  industry String?
  industryConfidence Int?
  linkedinCompanyUrl String?
  countryCode String?
  city String?
  decisionMakerRoleHints Json? @default("[]")
  lastEnrichedAt DateTime?

  sourceJson Json?

  leads Lead[]
  contacts Contact[]

  @@index([normalizedName])
  @@map("companies")
}

model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String

  leadId String @db.Uuid
  lead   Lead   @relation("LeadContacts", fields: [leadId], references: [id], onDelete: Cascade)

  companyId String? @db.Uuid
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  primaryFor Lead[] @relation("LeadPrimaryContact")
  outreachEvents OutreachEvent[]

  fullName   String?
  roleTitle  String?
  department String?
  seniority  String?
  linkedinUrl String?

  email String
  emailVerificationStatus EmailVerificationStatus @default(UNVERIFIED)
  emailVerifiedAt DateTime?
  emailVerificationProvider String?

  confidenceScore Int @default(0)
  source          String?
  discoveryMethod String?
  isPrimary       Boolean @default(false)
  isDecisionMaker Boolean @default(false)
  notesJson       Json?

  @@unique([leadId, email])
  @@index([leadId, isPrimary])
  @@index([companyId, createdAt])
  @@index([email])
  @@map("contacts")
}

model Campaign {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  name   String
  segmentName String?
  description String?
  qualityStrictness Int @default(50)
  targetRoles Json? @default("[]")

  searches Search[]
  leads Lead[]
  batches LeadBatch[]
  events OutreachEvent[]

  @@unique([userId, name])
  @@index([userId, createdAt])
  @@map("campaigns")
}

model LeadBatch {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  name   String
  code   String
  status BatchStatus @default(DRAFT)
  maxLeads Int?

  campaignId String? @db.Uuid
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  leads Lead[]
  events OutreachEvent[]

  @@unique([userId, code])
  @@index([userId, createdAt])
  @@map("lead_batches")
}

model OutreachEvent {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  provider        String
  externalEventId String
  messageId       String?
  type            OutreachEventType
  occurredAt      DateTime @default(now())
  email           String?
  payloadJson     Json?

  leadId String @db.Uuid
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  contactId String? @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  campaignId String? @db.Uuid
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  batchId String? @db.Uuid
  batch   LeadBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([leadId, occurredAt])
  @@index([contactId, occurredAt])
  @@index([campaignId, occurredAt])
  @@index([batchId, occurredAt])
  @@index([email])
  @@map("outreach_events")
}

model Job {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type   JobType
  status JobStatus @default(QUEUED)

  runAt DateTime @default(now())

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  lockedAt DateTime?
  lockedBy String?

  idempotencyKey String @unique

  payload Json?
  lastError String?

  @@index([status, runAt])
  @@index([lockedAt])
  @@map("jobs")
}

model ExternalApiCache {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider String
  cacheKey String

  fetchedAt DateTime @default(now())
  expiresAt DateTime

  statusCode Int?
  responseJson Json
  costUnits Int?

  @@unique([provider, cacheKey])
  @@index([provider, expiresAt])
  @@map("external_api_cache")
}

model EmailVerification {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())

  email    String
  provider String

  status EmailVerificationStatus
  checkedAt DateTime @default(now())
  rawResponseJson Json?

  @@unique([email, provider])
  @@index([email])
  @@map("email_verifications")
}

model UserPlan {
  userId String @id

  plan PlanType

  periodStart DateTime
  periodEnd   DateTime

  maxLeadsPerSearch Int
  maxEnhancedLeadsPerMonth Int
  maxEmailDiscoveriesPerMonth Int
  maxEmailVerificationsPerMonth Int

  @@map("user_plans")
}

model UsageCounter {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  periodStart DateTime
  periodEnd   DateTime

  enhancedLeadsUsed Int @default(0)
  emailDiscoveriesUsed Int @default(0)
  emailVerificationsUsed Int @default(0)

  @@unique([userId, periodStart, periodEnd])
  @@index([userId, periodEnd])
  @@map("usage_counters")
}

enum CreditAction {
  EMAIL_DISCOVER
  EMAIL_VERIFY
  AI_ENHANCE
  GENERATE_EMAIL
  SCRAPE
  TOPUP
}

enum CreditLedgerEntryType {
  CREDIT
  DEBIT
}

enum CreditLedgerEntryStatus {
  HOLD
  CAPTURED
  RELEASED
}

model CreditBalance {
  userId String @id

  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("credit_balances")
}

model AddonCreditBalance {
  userId String @id

  remaining Int @default(0)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("addon_credit_balances")
}

model PolarCustomer {
  userId String @id

  customerId String @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("polar_customers")
}

model PolarSubscription {
  id String @id @default(uuid()) @db.Uuid

  userId String
  subscriptionId String @unique
  productId String
  status String
  currentPeriodStart DateTime
  currentPeriodEnd DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("polar_subscriptions")
}

model CreditLedgerEntry {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String

  type   CreditLedgerEntryType
  status CreditLedgerEntryStatus
  action CreditAction?

  amount Int

  idempotencyKey String @unique
  metaJson       Json?

  @@index([userId, createdAt])
  @@index([userId, status])
  @@map("credit_ledger_entries")
}

model BlockedEmail {
  email     String   @id
  reason    String?
  createdAt DateTime @default(now())

  @@map("blocked_emails")
}
